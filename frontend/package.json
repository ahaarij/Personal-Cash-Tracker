    "idb": "^8.0.0",
    "lucide-react": "^0.414.0",
    "pocketbase": "^0.21.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tanstack/router-vite-plugin": "^1.48.1",
    "@testing-library/jest-dom": "^6.4.6",
