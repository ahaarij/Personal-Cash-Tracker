# ── Cash Flow App — environment variables ────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# PostgreSQL password (generate with: openssl rand -hex 32)
POSTGRES_PASSWORD=change_me_generate_with_openssl_rand_hex_32

# JWT signing secret (generate with: openssl rand -hex 64)
JWT_SECRET=change_me_generate_with_openssl_rand_hex_64

# Your app's public URL (set in Cloudflare Tunnel dashboard)
APP_URL=https://cashflow.yourdomain.com

# Cloudflare Tunnel token (from: cloudflared tunnel token cashflow)
CLOUDFLARE_TUNNEL_TOKEN=change_me_paste_tunnel_token_here

# Age public key for backup encryption (generate with: age-keygen)
# Store the PRIVATE key offline (not on this server)
BACKUP_ENCRYPTION_PUBKEY=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
